# Published HTTP redirect and HTTPS frontend ports
PORT=3124
HTTPS_PORT=4124
DOCKER_BIND_ADDRESS=127.0.0.1
YOUTUBE_API_KEY=your_youtube_api_key_here

# ssMusic server base URL and its read-only SEARCH_API_KEY (backend only)
SSMUSIC_SERVER_URL=https://192.168.6.66:4123/
SSMUSIC_API_KEY=your_ssmusic_search_api_key_here

# Optional trusted CA/self-signed public certificate; URL hostname must match its SAN.
# Docker: place the public certificate in ./certs/ssmusic-ca.pem.
# SSMUSIC_CA_CERT_FILE=/app/certs/ssmusic-ca.pem

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=karaoke_party

FRONTEND_URL=https://localhost:4124
REACT_APP_API_URL=/api
REACT_APP_SOCKET_URL=

# Example hosts
# FRONTEND_URL=https://your.host.com
# REACT_APP_API_URL=https://your.host.com/api
# REACT_APP_SOCKET_URL=https://your.host.com

# Passkey hostname and exact browser origin (include a non-default port).
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=https://localhost:4124
# Both secondary settings are required when enabling another origin.
# PASSKEY_RP_ID_SECONDARY=party.example.com
# PASSKEY_ORIGIN_SECONDARY=https://party.example.com

# Optional trusted TLS certificate and private key, mounted read-only in the frontend.
# When omitted, a self-signed certificate is generated in the persistent frontend_tls volume.
HTTPS_CERTS_DIR=./tls
# HTTPS_CERT_PATH=/run/karaoke-tls/fullchain.pem
# HTTPS_KEY_PATH=/run/karaoke-tls/privkey.pem

# Trust the bundled Nginx hop; keep the backend port private.
TRUST_PROXY=1

# Shared HOSTSCREEN credential; use a long random secret. Blank disables HOST login.
# Approved passkey users can retrieve it from Account Info in the three-dot menu.
HOST_SCREEN_LOGIN_KEY=