# public URL is baked into the frontend build:
#   FRONTEND_URL=https://yourdomain.com
#   REACT_APP_API_URL=https://yourdomain.com/api
#   REACT_APP_SOCKET_URL=https://yourdomain.com
REACT_APP_API_URL=
REACT_APP_SOCKET_URL=
