# Backend environment variables
PORT=5000
FRONTEND_URL=http://localhost:3000

# Enable only behind a trusted proxy; Compose defaults to its one bundled Nginx hop.
# TRUST_PROXY=1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=karaoke_party
DB_USER=postgres
DB_PASSWORD=postgres

# YouTube Data API v3 key (required for direct YouTube URL lookup)
YOUTUBE_API_KEY=your_youtube_api_key_here

# ssMusic server base URL and its read-only SEARCH_API_KEY (backend only)
SSMUSIC_SERVER_URL=https://music.example.com
SSMUSIC_API_KEY=your_ssmusic_search_api_key_here

# Optional trusted CA/self-signed public certificate for native Node.
# URL hostname must match the certificate; use a local absolute path.
# SSMUSIC_CA_CERT_FILE=C:/DATA/ss_karaoke_party/certs/ssmusic-ca.pem

# Passkey hostname and exact frontend origin. Non-localhost origins require HTTPS.
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3000
# PASSKEY_RP_ID_SECONDARY=party.example.com
# PASSKEY_ORIGIN_SECONDARY=https://party.example.com
