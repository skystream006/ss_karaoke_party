# Backend environment variables
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=karaoke_party
DB_USER=postgres
DB_PASSWORD=postgres

# YouTube Data API v3 key (required for direct YouTube URL lookup)
YOUTUBE_API_KEY=your_youtube_api_key_here

# ssMusic server base URL and its read-only SEARCH_API_KEY (backend only)
SSMUSIC_SERVER_URL=https://music.example.com
SSMUSIC_API_KEY=your_ssmusic_search_api_key_here

# Optional trusted CA/self-signed public certificate for native Node.
# URL hostname must match the certificate; use a local absolute path.
# SSMUSIC_CA_CERT_FILE=C:/DATA/ss_karaoke_party/certs/ssmusic-ca.pem

# API authentication passwords
# Admin password grants access to the settings page and all management APIs
API_ADMIN_PW=change_me_admin_password
# Member password grants access to join, guest, and organizer pages and their APIs
API_MEMBER_PW=change_me_member_password
