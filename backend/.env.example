# Backend environment variables
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=karaoke_party
DB_USER=postgres
DB_PASSWORD=postgres

# YouTube Data API v3 key (required for song search)
YOUTUBE_API_KEY=your_youtube_api_key_here

# API authentication passwords
# Admin password grants access to the settings page and all management APIs
API_ADMIN_PW=change_me_admin_password
# Member password grants access to join, guest, and organizer pages and their APIs
API_MEMBER_PW=change_me_member_password
